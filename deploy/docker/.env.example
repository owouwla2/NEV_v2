# NEV-v2 docker-compose 环境变量模板
# 用法：cp .env.example .env 后按需修改；不传 .env 时使用 compose 内置默认值。
# .env 含密码，已被 .gitignore 忽略，不会进库。

# MySQL ----------------------------------------------------------
MYSQL_PORT=13306
MYSQL_DATABASE=nev_v2
MYSQL_ROOT_PASSWORD=nev_v2_root_2026

# Redis ----------------------------------------------------------
# NEV-v2 fix B-1 (round-3 M-B): 默认 6379 在 Windows 10/11 + Hyper-V/WSL2 启用时经常被
# 系统保留（动态保留区如 6305-7404），导致 `docker-compose up` 报：
#   ports are not available: bind: An attempt was made to access a socket
#   in a way forbidden by its access permissions
# 推荐使用 16379 避开整个保留范围。可用 `netsh int ipv4 show excludedportrange protocol=tcp` 查保留区。
# 业务侧通过 application-*.yml 的 spring.data.redis.database=1 与老仓隔离。
REDIS_PORT=16379
REDIS_PASSWORD=nev_v2_redis_2026
